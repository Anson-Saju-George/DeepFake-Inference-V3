# DEEPFAKE_MODE selects the Docker build target.
# - local-gpu: CUDA/Torch image for local subprocess inference (needs NVIDIA Container Toolkit).
# - modal: slim API/static image, no CPU/local-GPU inference at all - dispatches to Modal.
DEEPFAKE_MODE=local-gpu

# HOST_PORT is the localhost port published by Docker Compose.
# - 8000 -> http://localhost:8000
# - 80   -> http://localhost
# Container internal port is always 8000.
HOST_PORT=8000

JWT_SECRET=
GOOGLE_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ALLOW_TEST_PAYMENTS=

# Comma-separated list of emails granted the admin role on Google sign-in
# (unlimited credits, full /system/status detail). Defaults to a single
# hardcoded fallback in main.py if left blank - set explicitly in production.
ADMIN_EMAILS=admin@example.com
CORS_ORIGINS=http://localhost:8000
MAX_IMAGE_MB=10
MAX_VIDEO_MB=50

# Inference backend switch. Leave blank to use DEEPFAKE_MODE's baked defaults;
# set explicitly to override.
INFERENCE_BACKEND_MODAL=
FALLBACK_TO_LOCAL=
MODAL_APP_NAME=
MODAL_FUNCTION_NAME=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
