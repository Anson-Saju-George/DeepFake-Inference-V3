*.egg
MANIFEST

# --- [ AI / ML WEIGHTS & LOGS ] ---
# Ignoring the heavy model checkpoints (PTH files) to avoid Git bloat
# We keep the directory structure but ignore the actual binaries
backend/models/image_models/*/checkpoints/*.pth
backend/models/image_models/*/old_checkpoints/
*.pth
*.weights
*.h5
backend/train_log.log
backend/models/image_models/train_log.log
*.log

# --- [ STORAGE & PERSISTENCE ] ---
# Ignore actual uploaded files and the SQLite database
backend/storage/uploads/*
!backend/storage/uploads/.keep
backend/storage/df_engine.db
backend/temp/

# --- [ SECRETS & CONFIG ] ---
.env
backend/.env
.env.*
!.env.example

# --- [ OS & IDE SPECIFIC ] ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

