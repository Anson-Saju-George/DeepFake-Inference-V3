# --- [ DEPENDENCIES ] ---
node_modules/
backend/venv/
.venv/
env/
venv.bak/
*.pip

# --- [ FRONTEND: REACT / VITE ] ---
deep-fake-app/dist/
deep-fake-app/stats.html
deep-fake-app/.env
deep-fake-app/.env.local
deep-fake-app/.env.development.local
deep-fake-app/.env.test.local
deep-fake-app/.env.production.local

# --- [ BACKEND: PYTHON / FASTAPI ] ---
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
